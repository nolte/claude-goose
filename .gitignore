# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.tmp
.idea/
.vscode/

# Spec Kit feature state — machine-local pointer, not shared project state
.specify/feature.json

# Review reports produced by ad-hoc runs.
# Reports that belong to the record are committed deliberately under
# tests/goose-implementation-review/ instead.
/review-report.md

# Vale styles are downloaded from a pinned package by `vale sync`, not authored
# here. Committing them would fork content that exists to be consumed.
# Everything under .vale except this project's own vocabulary is produced by
# `vale sync` from a pinned package. Committing it once already caused a CI
# failure: the stale copies sat at paths the config no longer searched.
.vale/*
!.vale/config/
.vale/config/*
!.vale/config/vocabularies/
.vale/config/vocabularies/*
!.vale/config/vocabularies/project/
